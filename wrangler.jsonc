{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orienta-turizm-staging",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node build-cms.cjs" },
  "vars": {
    "STAGING": "true",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": ""
  },
  // Set ADMIN_EMAILS through Wrangler secret / dashboard, never in Git.
  // Use the database UUID from Cloudflare. No resource is created by this file.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "orienta-turizm-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "orienta-turizm-media-staging"
  }]
}
