{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orienta-turizm-staging",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node build-cms.cjs" },
  "vars": {
    "STAGING": "true",
    "ADMIN_USERNAME": "yonetici"
  },
  // Set ADMIN_KEY_SHA256 through Worker secrets; generate with node scripts/create-admin-key.mjs.
  // Use the database UUID from Cloudflare. No resource is created by this file.
  "d1_databases": [{
    "binding": "DB",
    "database_name": "orienta-turizm-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "drizzle"
  }]}
