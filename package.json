{
  "name": "orienta-istanbul",
  "version": "1.0.0",
  "private": true,
  "description": "Orienta Istanbul website, blog and content management source",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build-cms.cjs",
    "test": "node test-cms.mjs && node test-seo.mjs && node test-security.mjs",
    "preview": "node preview-worker.mjs",
    "cf:dev": "wrangler dev --local",
    "cf:check": "wrangler deploy --dry-run",
    "test:runtime": "node test-runtime.mjs"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
